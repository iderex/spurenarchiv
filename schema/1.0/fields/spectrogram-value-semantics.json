          "counts",
          "count_rate",
          "mean_per_shot",
          "arbitrary_units"
        ]
      },
      "per": {
        "enum": [
          "bin",
          "unit_of_axis"
        ]
      },
      "bin_widths": {
        "type": "array",
        "items": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minItems": 1
      }
    },
    "allOf": [
      {
        "title": "A density carries the bin widths it was divided by, and a per-bin value carries none",
        "if": {
          "required": [
            "per"
          ],
          "properties": {
