  "allOf": [
    {
      "title": "detector_noise_parameters is required when noise_model is detector_specific",
      "description": "noise_model is detector_specific. Specified in docs/model/uncertainty.md.",
      "if": {
        "required": [
          "noise_model"
        ],
        "properties": {
          "noise_model": {
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "const": "detector_specific"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "detector_noise_parameters": {
            "$ref": "#/$defs/stated"
          }
        }
      }
    },
    {
      "title": "energy_calibration is required when energy_axis_quantity is kinetic_energy",
      "description": "energy_axis_quantity is kinetic_energy. Specified in docs/model/energy-calibration.md and argued in docs/decisions/conventions.md under kinetic energy against time of flight.",
      "if": {
        "required": [
          "energy_axis_quantity"
        ],
        "properties": {
          "energy_axis_quantity": {
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "const": "kinetic_energy"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "energy_calibration": {
            "$ref": "#/$defs/stated"
          }
        }
      }
    },
    {
      "title": "shots_per_point is required when completeness_level is counts or scaled",
      "description": "completeness_level is counts or scaled. Specified in docs/model/acquisition.md and required by docs/decisions/raw-counts.md as part of what those two levels mean.",
      "if": {
        "required": [
          "completeness_level"
        ],
        "properties": {
          "completeness_level": {
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "enum": [
                  "counts",
                  "scaled"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "shots_per_point": {
            "$ref": "#/$defs/stated"
          }
        }
      }
    },
    {
      "title": "stage_to_delay_relation is required when delay_axis_quantity is stage_position",
      "description": "delay_axis_quantity is stage_position. Specified in docs/model/delay-axis.md and argued in docs/decisions/conventions.md under the stage and the factor of two.",
      "if": {
        "required": [
          "delay_axis_quantity"
        ],
        "properties": {
          "delay_axis_quantity": {
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "const": "stage_position"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "stage_to_delay_relation": {
            "$ref": "#/$defs/stated"
          }
        }
      }
    }
  ],
  "$defs": {
    "absence_state": {
      "description": "The six states of docs/decisions/absence.md and no others. A seventh spelling is a writer inventing one.",
      "enum": [
        "present",
        "estimated",
        "not_measured",
        "not_applicable",
        "not_recorded",
        "withheld"
      ]
    },
    "field_record": {
      "description": "Every field the model defines is present in a deposit, carrying a value or carrying the state that says why it does not. The state sits with the field rather than in a structure beside it, so a writer that never heard of the states cannot emit the values without them.",
      "type": "object",
      "required": [
        "state"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "$ref": "#/$defs/absence_state"
        },
        "value": {
          "description": "Narrowed to the field's own subschema where this record is used.",
          "$comment": "Unconstrained here; each field's entry references its row's schema object."
        },
        "basis": {
          "description": "What the estimate was derived from, or the statement that it is a typical value for this apparatus.",
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "lifted_by": {
          "description": "The date or the named event after which a withheld value is published.",
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "allOf": [
        {
          "title": "A state that carries a value carries one, and a state that carries none carries none",
          "if": {
            "required": [
              "state"
            ],
            "properties": {
              "state": {
                "enum": [
                  "present",
                  "estimated"
                ]
              }
            }
          },
          "then": {
            "required": [
              "value"
            ]
          },
          "else": {
            "not": {
              "required": [
                "value"
              ]
            }
          }
        },
        {
          "title": "An estimate carries its basis, and nothing else carries one",
          "if": {
            "required": [
              "state"
            ],
            "properties": {
              "state": {
                "const": "estimated"
              }
            }
          },
          "then": {
            "required": [
              "basis"
            ]
          },
          "else": {
            "not": {
              "required": [
                "basis"
              ]
            }
          }
        },
        {
          "title": "A withheld value carries what lifts it, and nothing else carries one",
          "if": {
            "required": [
              "state"
            ],
            "properties": {
              "state": {
                "const": "withheld"
              }
            }
          },
          "then": {
            "required": [
              "lifted_by"
            ]
          },
          "else": {
            "not": {
              "required": [
                "lifted_by"
              ]
            }
          }
        }
      ]
    },
    "stated": {
      "description": "The deposit does not stand without this field, so the only states it may be in are the two that carry a number.",
      "properties": {
        "state": {
          "enum": [
            "present",
            "estimated"
          ]
        }
