# Array files are the values and nothing else, so nothing may rewrite a byte of
# them on the way into or out of git. A checkout that converted a line ending
# inside one would change the array's digest, which is the failure
# docs/spec/content-address.md exists against. -diff keeps them out of a textual
# diff, where they are noise rather than review.
*.bin -text -diff

# The same reason one level wider. Every file under this directory has its bytes
# hashed by .github/workflows/content-address.yml, including the metadata
# documents, so a checkout that rewrote their line endings would move digests
# that are pinned beside them and the check would fail for a reason that has
# nothing to do with the construction it judges.
fixtures/content-address/** -text

# The same reason again, for the deposits .github/workflows/deposit-manifest.yml
# judges. Every file under this directory has its length and its digest recorded
# in the manifest beside it, so a checkout that rewrote a line ending inside one
# would make a fixture fail for a reason that has nothing to do with the rule it
# exists to prove, and one of these fixtures exists to prove a length that is
# wrong by 64 bytes.
fixtures/manifest/** -text
